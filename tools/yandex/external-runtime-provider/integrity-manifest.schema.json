{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yandex-games-starter-kit.local/schemas/hardened-runtime-provider-integrity-manifest-v2.json",
  "title": "Hardened Yandex Draft Runtime Provider integrity manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "manifestKind",
    "providerVersion",
    "securityPolicyVersion",
    "hashPolicy",
    "upstream",
    "repin",
    "runtimeClosure",
    "provenanceInputs"
  ],
  "properties": {
    "$schema": { "const": "./integrity-manifest.schema.json" },
    "schemaVersion": { "const": 2 },
    "manifestKind": { "const": "hardened-yandex-draft-runtime-provider" },
    "providerVersion": { "const": "hardened-draft-runtime-harness-1.3.0" },
    "securityPolicyVersion": { "const": "1.3.0" },
    "hashPolicy": { "const": "raw-bytes-sha256-v1" },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "candidate", "auditedDate"],
      "properties": {
        "repository": { "const": "Nioris/yandex-games-debug-checker" },
        "commit": { "const": "0bc5ef9123f471b43c0a2683afb990fe0793f9a5" },
        "candidate": { "const": "v1.2.8-test" },
        "auditedDate": { "const": "2026-08-28" }
      }
    },
    "repin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previousProviderVersion", "previousValidatedManifestSha256", "reason"],
      "properties": {
        "previousProviderVersion": { "const": "hardened-draft-runtime-harness-1.2.0" },
        "previousValidatedManifestSha256": { "const": "6fb633f59e0d76d5e863f24ff36172b01551562efefa6627d1138b206372f989" },
        "reason": { "const": "RUNTIME_INTEGRITY_CLOSURE_REFINEMENT" }
      }
    },
    "runtimeClosure": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "role", "required"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "role": { "type": "string", "minLength": 1 },
          "required": { "const": true }
        }
      }
    },
    "provenanceInputs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "commit",
          "candidate",
          "historicalPath",
          "originalFileName",
          "sha256",
          "auditedDate",
          "relationship",
          "runtimeRequired"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "repository": { "const": "Nioris/yandex-games-debug-checker" },
          "commit": { "const": "0bc5ef9123f471b43c0a2683afb990fe0793f9a5" },
          "candidate": { "const": "v1.2.8-test" },
          "historicalPath": { "type": "string", "minLength": 1 },
          "originalFileName": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "auditedDate": { "const": "2026-08-28" },
          "relationship": { "type": "string", "minLength": 10 },
          "runtimeRequired": { "const": false }
        }
      }
    }
  }
}
