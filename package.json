{
  "name": "yandex-games-autonomous-starter-kit",
  "private": true,
  "version": "0.5.6",
  "type": "module",
  "starterKit": {
    "targetScripts": [
      "starter-kit:self-test",
      "starter-kit:status",
      "skills:validate",
      "yandex:requirements:audit",
      "yandex:console:audit",
      "yandex:docs:check",
      "yandex:docs:accept-snapshot",
      "yandex:media:validate"
    ]
  },
  "scripts": {
    "starter-kit:self-test": "node tools/starter-kit/self-test.mjs",
    "starter-kit:manifest": "node tools/starter-kit/build-manifest.mjs",
    "starter-kit:status": "node tools/starter-kit/status.mjs",
    "starter-kit:init": "node tools/starter-kit/init-project.mjs",
    "starter-kit:package": "node tools/starter-kit/package-kit.mjs",
    "starter-kit:update": "node tools/starter-kit/apply-update.mjs",
    "starter-kit:update-self-test": "node tools/starter-kit/update-self-test.mjs",
    "test:updater": "node --test tests/starter-kit/*.test.mjs",
    "yandex:requirements:audit": "node tools/yandex/requirements-audit.mjs",
    "yandex:console:audit": "node tools/yandex/requirements-audit.mjs --console-only",
    "yandex:docs:check": "node tools/yandex/docs-watch.mjs",
    "yandex:docs:accept-snapshot": "node tools/yandex/docs-watch.mjs --accept-snapshot",
    "yandex:media:validate": "node tools/yandex/media-validation.mjs",
    "skills:validate": "node tools/starter-kit/self-test.mjs"
  }
}
